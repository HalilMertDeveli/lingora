rules_version = '2';

// Dilmaç Firestore rules. The server-side data (leagues, entitlements,
// quotas) is written only by Cloud Functions through the Admin SDK, which
// bypasses these rules. Clients may write only their own users/{uid} doc.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Progress snapshot synced by the app (lib/services/firebase/progress_sync.dart):
    // {schemaVersion, progress, totalXp, displayName, clientUpdatedAt, updatedAt}.
    // Progress.toJson() has ~25 keys today; 60 leaves room to grow. The 1 MiB
    // document limit caps the total size.
    function validUserDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion', 'progress', 'totalXp', 'displayName', 'clientUpdatedAt', 'updatedAt'])
        && d.keys().hasAll(['progress', 'updatedAt'])
        && d.progress is map
        && d.progress.size() <= 60
        && d.updatedAt is timestamp
        && d.updatedAt == request.time
        && (!('schemaVersion' in d) || (d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 1000))
        && (!('totalXp' in d) || (d.totalXp is int && d.totalXp >= 0))
        && (!('clientUpdatedAt' in d) || d.clientUpdatedAt is int)
        && (!('displayName' in d) || d.displayName == null
          || (d.displayName is string && d.displayName.size() <= 40));
    }

    // Progress follows the account to other phones for every learner who
    // signed in with Google, e-mail or phone. Guests (anonymous sign-in) keep
    // it on the device: their uid is lost with the phone, so a copy would only
    // cost storage.
    function hasAccount() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // deletedAccounts/{uid}: written by deleteAccount. Another phone still
      // signed in to the deleted account (its token lives up to an hour) must
      // not write the progress back.
      allow create, update: if isOwner(uid) && validUserDoc() && hasAccount()
        && !exists(/databases/$(database)/documents/deletedAccounts/$(uid));
      allow delete: if false;
    }

    // Tier, current group and last week's result. Written by functions.
    match /leagueState/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Premium, exam packs and family membership. Written only by Cloud
    // Functions (verifyPurchase, family callables). families/{ownerUid} and
    // familyCodes/{code} are server-only (catch-all below).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // One Dünya Ligi group of up to 100 people: leagues/{weekKey}_{tier}_{group}.
    // Only its members may see it; XP changes go through addLeagueXp.
    match /leagues/{groupId} {
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/leagues/$(groupId)/members/$(request.auth.uid));
      }

      allow read: if isMember();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // ---- Dilmaç Kurumsal (functions/src/orgs.ts, docs/kurumsal.md) ----
    // Org data is read and written only through the org* callables, which
    // filter the progress report (KVKK: no diary, notes or chats). A user may
    // read which org they belong to.
    match /memberships/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /orgs/{orgId}/{document=**} {
      allow read, write: if false;
    }

    match /orgCodes/{code} {
      allow read, write: if false;
    }
    // ---- end Dilmaç Kurumsal ----

    // ---- Friends (lib/services/friends.dart, docs/firebase-backend.md) ----
    // Works without Cloud Functions. Knowing a friend's code, or accepting
    // their friend request, is the consent to become friends; either side
    // can remove the friendship.

    // Turkish day number (UTC+3, no daylight saving) of the request.
    function trDay() {
      return int(math.floor((request.time.toMillis() + 10800000) / 86400000));
    }

    function validName(s) {
      return s is string && s.size() >= 1 && s.size() <= 24;
    }

    function validAvatar(s) {
      return s is string && s.size() >= 1 && s.size() <= 8;
    }

    match /friendCodes/{code} {
      function validCode() {
        let d = request.resource.data;
        return code.matches('^[A-HJ-NP-Z2-9]{8}$')
          && d.keys().hasOnly(['uid', 'name', 'avatar', 'createdAt'])
          && d.keys().hasAll(['uid', 'name', 'avatar', 'createdAt'])
          && d.uid == request.auth.uid
          && validName(d.name)
          && validAvatar(d.avatar)
          && d.createdAt == request.time;
      }

      allow get: if signedIn() && hasAccount();
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && hasAccount() && validCode();
      allow update: if signedIn() && hasAccount() && resource.data.uid == request.auth.uid && validCode();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // friendships/{a}_{b} with a < b: names, avatars, the Turkish day each
    // member last reached the daily goal (done) and the shared streak.
    match /friendships/{pairId} {
      function otherOf(members) {
        return members[0] == request.auth.uid ? members[1] : members[0];
      }

      function validPeople(d) {
        let m = d.members;
        return d.names is map && d.avatars is map
          && d.names.keys().hasOnly(m) && d.names.keys().hasAll(m)
          && d.avatars.keys().hasOnly(m) && d.avatars.keys().hasAll(m)
          && validName(d.names[m[0]]) && validName(d.names[m[1]])
          && validAvatar(d.avatars[m[0]]) && validAvatar(d.avatars[m[1]]);
      }

      function validNew() {
        let d = request.resource.data;
        let m = d.members;
        return d.keys().hasOnly(['members', 'code', 'names', 'avatars', 'done', 'streak', 'best', 'streakDay', 'createdAt'])
          && d.keys().hasAll(['members', 'code', 'names', 'avatars', 'done', 'streak', 'best', 'streakDay', 'createdAt'])
          && m is list && m.size() == 2
          && m[0] is string && m[1] is string && m[0] < m[1]
          && pairId == m[0] + '_' + m[1]
          && request.auth.uid in m
          && d.code is string
          && validPeople(d)
          && d.done == {}
          && d.streak == 0 && d.best == 0 && d.streakDay == 0
          && d.createdAt == request.time;
      }

      // The friend's code must exist, belong to the friend and carry the
      // name and avatar written for them.
      function codeMatches() {
        let d = request.resource.data;
        let other = otherOf(d.members);
        let path = /databases/$(database)/documents/friendCodes/$(d.code);
        return exists(path)
          && get(path).data.uid == other
          && d.names[other] == get(path).data.name
          && d.avatars[other] == get(path).data.avatar;
      }

      // Only the caller's own entries in names, avatars and done change;
      // done may only move forward to today.
      function validOwnChange() {
        let me = request.auth.uid;
        let d = request.resource.data;
        let old = resource.data;
        let oldDone = old.done.get(me, 0);
        let newDone = d.done.get(me, 0);
        return d.diff(old).affectedKeys().hasOnly(['done', 'names', 'avatars', 'streak', 'best', 'streakDay'])
          && d.names.diff(old.names).affectedKeys().hasOnly([me])
          && d.avatars.diff(old.avatars).affectedKeys().hasOnly([me])
          && d.done.diff(old.done).affectedKeys().hasOnly([me])
          && validPeople(d)
          && (newDone == oldDone || (newDone == trDay() && newDone > oldDone));
      }

      // The shared streak grows once on the first day both reached the goal;
      // a missed day restarts it at 1. Nothing else may change it.
      function validStreak() {
        let me = request.auth.uid;
        let d = request.resource.data;
        let old = resource.data;
        let t = trDay();
        let bump = d.done.get(me, 0) == t
          && old.done.get(otherOf(old.members), 0) == t
          && old.streakDay != t;
        let next = old.streakDay == t - 1 ? old.streak + 1 : 1;
        return bump
          ? d.streak == next && d.streakDay == t && d.best == (next > old.best ? next : old.best)
          : d.streak == old.streak && d.streakDay == old.streakDay && d.best == old.best;
      }

      // Or: the friend asked first (friendRequests/{friend}_{me}) and the
      // names and avatars are theirs. The accepting app writes this and
      // deletes the request in one batch; get() sees the state before it.
      function requestMatches() {
        let d = request.resource.data;
        let other = otherOf(d.members);
        let path = /databases/$(database)/documents/friendRequests/$(other + '_' + request.auth.uid);
        return exists(path)
          && d.names[other] == get(path).data.name
          && d.avatars[other] == get(path).data.avatar;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // A ternary, so codeMatches() never looks up an empty code.
      allow create: if signedIn() && hasAccount() && validNew()
        && (request.resource.data.code == '' ? requestMatches() : codeMatches());
      allow update: if signedIn() && hasAccount()
        && request.auth.uid in resource.data.members
        && validOwnChange() && validStreak();
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // Preset cheers (no free text), at most one per kind per day.
      match /cheers/{cheerId} {
        function parent() {
          return get(/databases/$(database)/documents/friendships/$(pairId)).data;
        }

        function isMember() {
          return signedIn()
            && exists(/databases/$(database)/documents/friendships/$(pairId))
            && request.auth.uid in parent().members;
        }

        function validCheer() {
          let d = request.resource.data;
          return d.keys().hasOnly(['from', 'to', 'kind', 'day', 'createdAt'])
            && d.keys().hasAll(['from', 'to', 'kind', 'day', 'createdAt'])
            && d.from == request.auth.uid
            && d.to == otherOf(parent().members)
            && d.kind in ['tebrik', 'destek', 'hadi', 'harika']
            && d.day == trDay()
            && d.createdAt == request.time
            && cheerId == d.from + '_' + string(d.day) + '_' + d.kind;
        }

        allow read: if isMember();
        allow create: if hasAccount() && isMember() && validCheer();
        allow update: if false;
        allow delete: if isMember();
      }
    }

    // friendRequests/{from}_{to}: a request sent from the phone book
    // ("Rehberden bul"), with the sender's name and avatar. Only the two
    // people can see it; the receiver accepts (friendships create above)
    // or declines (delete), the sender may withdraw it (delete).
    match /friendRequests/{reqId} {
      function validRequest() {
        let d = request.resource.data;
        let pair = d.from < d.to ? d.from + '_' + d.to : d.to + '_' + d.from;
        return d.keys().hasOnly(['from', 'to', 'name', 'avatar', 'createdAt'])
          && d.keys().hasAll(['from', 'to', 'name', 'avatar', 'createdAt'])
          && d.from == request.auth.uid
          && d.to is string && d.to.size() >= 1 && d.to.size() <= 128
          && d.to != d.from
          && reqId == d.from + '_' + d.to
          && validName(d.name)
          && validAvatar(d.avatar)
          && d.createdAt == request.time
          && !exists(/databases/$(database)/documents/friendships/$(pair));
      }

      function isParty() {
        return signedIn()
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }

      // Queries must filter on from == me or to == me.
      allow read: if isParty();
      allow create: if signedIn() && hasAccount() && validRequest();
      allow update: if false;
      allow delete: if isParty();
    }

    // phoneIndex/{hash} → {uid, createdAt}: opt-in "find me by my number"
    // (docs/arkadaslar.md). hash = hex SHA-256 of the salt and the E.164
    // number, as phoneHash() in lib/services/contacts/phone_numbers.dart.
    // Only the number verified by Firebase phone sign-in (the token's
    // phone_number) can be published, and only as this hash. Lookups are
    // single gets; the index can never be listed.
    match /phoneIndex/{hash} {
      function hasPhone() {
        return request.auth.token.get('phone_number', null) is string;
      }

      function myHash() {
        return hashing.sha256('dilmac-rehber-v1:' + request.auth.token.phone_number).toHexString().lower();
      }

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'createdAt'])
          && d.keys().hasAll(['uid', 'createdAt'])
          && d.uid == request.auth.uid
          && d.createdAt == request.time;
      }

      allow get: if signedIn() && hasAccount();
      allow list: if false;
      // update: the verified owner of a number takes over a stale entry.
      allow create, update: if signedIn() && hasAccount() && hasPhone() && hash == myHash() && validEntry();
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || (hasPhone() && hash == myHash()));
    }
    // ---- end Friends ----

    // ---- Profile (lib/services/profile.dart) ----
    // {name, photo, clientUpdatedAt, updatedAt}: the learner's chosen name
    // and a 256 px JPEG avatar kept in the document (no Cloud Storage on the
    // Spark plan). Guests keep both on the device. Friends may read it.
    // `showcase` {avatar, frame, items ≤ 3, useAvatar, theme, mascot, pofuduk}
    // holds the Mağaza item ids the learner shows friends
    // (lib/services/showcase.dart): avatar and frame, up to three featured
    // items, and the worn theme and mascot outfits (`mascot` for Çaycı Dayı,
    // `pofuduk` for Pofuduk). Only known catalog ids are accepted, each in
    // its own slot. Without Cloud Functions the rules cannot check that the
    // items were bought: a learner could at most show an item they do not
    // own, to their friends.
    match /profiles/{uid} {
      // Must match lib/data/shop_catalog.dart; test/showcase_test.dart checks it.
      function knownItemId(v) {
        return v is string && v in [
          'av_cay', 'av_kedi', 'av_tilki', 'av_baykus', 'av_kaplumbaga', 'av_yunus',
          'av_ari', 'av_lale', 'av_nazar', 'av_marti', 'av_ahtapot', 'av_aslan',
          'av_roket', 'av_kirpi', 'av_flamingo', 'av_karpuz', 'av_balina', 'av_ejderha',
          'av_unicorn', 'av_p_kartal', 'av_p_tavus', 'av_p_elmas', 'av_p_yildiz', 'fr_bakir',
          'fr_gumus', 'fr_altin', 'fr_iznik', 'fr_gunbatimi', 'fr_nazar', 'fr_p_kraliyet',
          'fr_p_kutup', 'mx_gozluk', 'mx_atki', 'mx_madalya', 'mx_lale', 'mx_tac',
          'fr_gokkusagi', 'fr_ates', 'fr_deniz', 'px_sapka', 'px_kurdele', 'px_kep',
          'px_cicek', 'px_tac', 'th_cay', 'th_iznik', 'th_zeytin', 'th_lavanta',
          'th_lokum'
        ];
      }

      // An optional showcase slot: absent, null, or a known id with [prefix].
      function optionalSlot(s, key, prefix) {
        return !(key in s) || s[key] == null
          || (knownItemId(s[key]) && s[key].matches('^' + prefix + '_.*'));
      }

      function validShowcase(s) {
        return s is map
          && s.keys().hasOnly(['avatar', 'frame', 'items', 'useAvatar', 'theme', 'mascot', 'pofuduk'])
          && (!('useAvatar' in s) || s.useAvatar is bool)
          && s.keys().hasAll(['avatar', 'frame', 'items'])
          && (s.avatar == null || (knownItemId(s.avatar) && s.avatar.matches('^av_.*')))
          && (s.frame == null || (knownItemId(s.frame) && s.frame.matches('^fr_.*')))
          && optionalSlot(s, 'theme', 'th')
          && optionalSlot(s, 'mascot', 'mx')
          && optionalSlot(s, 'pofuduk', 'px')
          && s.items is list
          && s.items.size() <= 3
          && (s.items.size() < 1 || knownItemId(s.items[0]))
          && (s.items.size() < 2 || knownItemId(s.items[1]))
          && (s.items.size() < 3 || knownItemId(s.items[2]));
      }

      function isFriend() {
        let me = request.auth.uid;
        let pair = me < uid ? me + '_' + uid : uid + '_' + me;
        return exists(/databases/$(database)/documents/friendships/$(pair));
      }

      // A JPEG (starts with FF D8 FF) of at most 60 KiB.
      function validPhoto(p) {
        return p is bytes && p.size() >= 100 && p.size() <= 61440 && p.toHexString()[0:6] == 'FFD8FF';
      }

      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'photo', 'clientUpdatedAt', 'updatedAt', 'showcase'])
          && d.keys().hasAll(['updatedAt'])
          && d.updatedAt == request.time
          && (!('name' in d) || d.name == null || validName(d.name))
          && (!('photo' in d) || d.photo == null || validPhoto(d.photo))
          && (!('clientUpdatedAt' in d) || d.clientUpdatedAt is int)
          && (!('showcase' in d) || validShowcase(d.showcase));
      }

      allow read: if isOwner(uid) || (signedIn() && hasAccount() && isFriend());
      allow create, update: if isOwner(uid) && hasAccount() && validProfile();
      allow delete: if isOwner(uid);
    }
    // ---- end Profile ----

    // ---- Kurum lisansı ve sınıflar (lib/kurum/, docs/kurumlar.md) ----
    // Works without Cloud Functions (Spark plan): these rules are the whole
    // server side. Seat codes are created only by the operator (Admin SDK,
    // functions/scripts/license_codes.mjs); a user claims one in a batch that
    // also writes licenses/{uid}. Teachers see only the summary their own
    // students' apps publish: no e-mail, phone, notes or diary.

    function licensePath(uid) {
      return /databases/$(database)/documents/licenses/$(uid);
    }

    function codePath(code) {
      return /databases/$(database)/documents/licenseCodes/$(code);
    }

    // The caller holds a license that has not expired (before this write).
    function hasActiveLicense() {
      return exists(licensePath(request.auth.uid))
        && get(licensePath(request.auth.uid)).data.expiresAt > request.time;
    }

    match /licenseCodes/{code} {
      function validClaim() {
        let d = request.resource.data;
        return code.matches('^[A-HJ-NP-Z2-9]{12}$')
          && resource.data.claimedBy == null
          && resource.data.expiresAt > request.time
          && d.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
          && d.claimedBy == request.auth.uid
          && d.claimedAt == request.time
          && !hasActiveLicense()
          && getAfter(licensePath(request.auth.uid)).data.code == code;
      }

      allow get: if signedIn() && hasAccount();
      allow list, create, delete: if false;
      allow update: if signedIn() && hasAccount() && validClaim();
    }

    match /licenses/{uid} {
      // Copies the claimed code's org, role and end date.
      function validLicense() {
        let d = request.resource.data;
        let c = getAfter(codePath(d.code)).data;
        return d.keys().hasOnly(['code', 'org', 'role', 'expiresAt', 'claimedAt'])
          && d.keys().hasAll(['code', 'org', 'role', 'expiresAt', 'claimedAt'])
          && d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{12}$')
          && c.claimedBy == uid
          && d.org == c.org
          && d.role == c.role
          && d.expiresAt == c.expiresAt
          && d.claimedAt == request.time;
      }

      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && hasAccount() && validLicense();
      // An active license cannot be swapped for another seat.
      allow update: if isOwner(uid) && hasAccount() && validLicense()
        && (resource.data.expiresAt <= request.time || resource.data.code == request.resource.data.code);
      allow delete: if isOwner(uid) && resource.data.expiresAt <= request.time;
    }

    // classes/{code}: the doc id is the 8-character join code.
    match /classes/{code} {
      function classData() {
        return get(/databases/$(database)/documents/classes/$(code)).data;
      }

      function isClassOwner() {
        return signedIn()
          && exists(/databases/$(database)/documents/classes/$(code))
          && classData().ownerUid == request.auth.uid;
      }

      function validClassFields(d) {
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && validName(d.teacherName)
          && d.open is bool;
      }

      // Only a teacher with an active seat whose code is still theirs.
      function isTeacher() {
        let l = get(licensePath(request.auth.uid)).data;
        return hasActiveLicense()
          && l.role == 'teacher'
          && get(codePath(l.code)).data.claimedBy == request.auth.uid
          && request.resource.data.org == l.org;
      }

      function validNewClass() {
        let d = request.resource.data;
        return code.matches('^[A-HJ-NP-Z2-9]{8}$')
          && d.keys().hasOnly(['ownerUid', 'name', 'teacherName', 'org', 'open', 'createdAt'])
          && d.keys().hasAll(['ownerUid', 'name', 'teacherName', 'org', 'open', 'createdAt'])
          && d.ownerUid == request.auth.uid
          && d.createdAt == request.time
          && validClassFields(d);
      }

      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && hasAccount() && validNewClass() && isTeacher();
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'open', 'teacherName'])
        && validClassFields(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // A student's progress summary, written by the student's own app.
      match /members/{memberUid} {
        function errorOk(l, i) {
          return l.size() <= i || (l[i] is string && l[i].matches('^[a-zA-Z]{1,24}$'));
        }

        function validMember() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'streak', 'lessonsDone', 'unitsDone', 'weekXp', 'week', 'topErrors', 'joinedAt', 'updatedAt'])
            && d.keys().hasAll(['name', 'streak', 'lessonsDone', 'unitsDone', 'weekXp', 'week', 'topErrors', 'joinedAt', 'updatedAt'])
            && validName(d.name)
            && d.streak is int && d.streak >= 0 && d.streak <= 10000
            && d.lessonsDone is int && d.lessonsDone >= 0 && d.lessonsDone <= 100000
            && d.unitsDone is int && d.unitsDone >= 0 && d.unitsDone <= 10000
            && d.weekXp is int && d.weekXp >= 0 && d.weekXp <= 1000000
            && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.topErrors is list && d.topErrors.size() <= 3
            && errorOk(d.topErrors, 0) && errorOk(d.topErrors, 1) && errorOk(d.topErrors, 2)
            && d.joinedAt is timestamp
            && d.updatedAt == request.time;
        }

        function isMe() {
          return signedIn() && request.auth.uid == memberUid;
        }

        allow read: if isMe() || isClassOwner();
        allow create: if isMe()
          && exists(/databases/$(database)/documents/classes/$(code))
          && classData().open == true
          && validMember()
          && request.resource.data.joinedAt == request.time;
        allow update: if isMe() && validMember() && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if isMe() || isClassOwner();
      }
    }

    // The classes a user joined, so another phone keeps reporting.
    match /classLinks/{uid} {
      function validLinks() {
        let d = request.resource.data;
        return d.keys().hasOnly(['codes', 'updatedAt'])
          && d.keys().hasAll(['codes', 'updatedAt'])
          && d.codes is list && d.codes.size() <= 5
          && d.updatedAt == request.time;
      }

      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validLinks();
    }
    // ---- end Kurum lisansı ----

    // Mülakat Provası history (functions/src/rehearsal.ts): transcripts and
    // the analysis, written only by analyzeRehearsal (audio stays on the
    // phone). The learner may read and delete their own; usageRehearsal/{uid}
    // (the free-try counter) is server-only via the catch-all below.
    match /rehearsals/{uid}/items/{rehearsalId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if false;
    }

    // Forced update (docs/zorunlu-guncelleme.md): every app reads the minimum
    // and recommended version at start, even before signing in. Only the
    // owner changes it, in the Firebase console. Other config/ documents
    // (config/lingoraAdmins) stay server-only through the catch-all.
    match /config/app {
      allow get: if true;
      allow list, write: if false;
    }

    // Owner dashboard counters (functions/src/stats.ts), aggregated only.
    // Read through the getStats callable (Dilmaç staff); never by clients.
    match /stats/{document=**} {
      allow read, write: if false;
    }

    // Everything else (quotas, purchase tokens, counters) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
