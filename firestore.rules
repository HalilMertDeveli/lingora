rules_version = '2';

// Dilbaz Firestore rules. The server-side data (leagues, entitlements,
// quotas) is written only by Cloud Functions through the Admin SDK, which
// bypasses these rules. Clients may write only their own users/{uid} doc.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Progress snapshot synced by the app (lib/services/firebase/progress_sync.dart):
    // {schemaVersion, progress, totalXp, displayName, clientUpdatedAt, updatedAt}.
    // Progress.toJson() has ~25 keys today; 60 leaves room to grow. The 1 MiB
    // document limit caps the total size.
    function validUserDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion', 'progress', 'totalXp', 'displayName', 'clientUpdatedAt', 'updatedAt'])
        && d.keys().hasAll(['progress', 'updatedAt'])
        && d.progress is map
        && d.progress.size() <= 60
        && d.updatedAt is timestamp
        && d.updatedAt == request.time
        && (!('schemaVersion' in d) || (d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 1000))
        && (!('totalXp' in d) || (d.totalXp is int && d.totalXp >= 0))
        && (!('clientUpdatedAt' in d) || d.clientUpdatedAt is int)
        && (!('displayName' in d) || d.displayName == null
          || (d.displayName is string && d.displayName.size() <= 40));
    }

    // Progress follows the account to other phones for every learner who
    // signed in with Google, e-mail or phone. Guests (anonymous sign-in) keep
    // it on the device: their uid is lost with the phone, so a copy would only
    // cost storage.
    function hasAccount() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc() && hasAccount();
      allow delete: if false;
    }

    // Tier, current group and last week's result. Written by functions.
    match /leagueState/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Premium, exam packs and family membership. Written only by Cloud
    // Functions (verifyPurchase, family callables). families/{ownerUid} and
    // familyCodes/{code} are server-only (catch-all below).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // One league group of up to 15 people: leagues/{weekKey}_{tier}_{group}.
    // Only its members may see it; XP changes go through addLeagueXp.
    match /leagues/{groupId} {
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/leagues/$(groupId)/members/$(request.auth.uid));
      }

      allow read: if isMember();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // ---- Dilbaz Kurumsal (functions/src/orgs.ts, docs/kurumsal.md) ----
    // Org data is read and written only through the org* callables, which
    // filter the progress report (KVKK: no diary, notes or chats). A user may
    // read which org they belong to.
    match /memberships/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /orgs/{orgId}/{document=**} {
      allow read, write: if false;
    }

    match /orgCodes/{code} {
      allow read, write: if false;
    }
    // ---- end Dilbaz Kurumsal ----

    // ---- Friends (lib/services/friends.dart, docs/firebase-backend.md) ----
    // Works without Cloud Functions. Knowing a friend's code is the consent
    // to become friends; either side can remove the friendship.

    // Turkish day number (UTC+3, no daylight saving) of the request.
    function trDay() {
      return int(math.floor((request.time.toMillis() + 10800000) / 86400000));
    }

    function validName(s) {
      return s is string && s.size() >= 1 && s.size() <= 24;
    }

    function validAvatar(s) {
      return s is string && s.size() >= 1 && s.size() <= 8;
    }

    match /friendCodes/{code} {
      function validCode() {
        let d = request.resource.data;
        return code.matches('^[A-HJ-NP-Z2-9]{8}$')
          && d.keys().hasOnly(['uid', 'name', 'avatar', 'createdAt'])
          && d.keys().hasAll(['uid', 'name', 'avatar', 'createdAt'])
          && d.uid == request.auth.uid
          && validName(d.name)
          && validAvatar(d.avatar)
          && d.createdAt == request.time;
      }

      allow get: if signedIn() && hasAccount();
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && hasAccount() && validCode();
      allow update: if signedIn() && hasAccount() && resource.data.uid == request.auth.uid && validCode();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // friendships/{a}_{b} with a < b: names, avatars, the Turkish day each
    // member last reached the daily goal (done) and the shared streak.
    match /friendships/{pairId} {
      function otherOf(members) {
        return members[0] == request.auth.uid ? members[1] : members[0];
      }

      function validPeople(d) {
        let m = d.members;
        return d.names is map && d.avatars is map
          && d.names.keys().hasOnly(m) && d.names.keys().hasAll(m)
          && d.avatars.keys().hasOnly(m) && d.avatars.keys().hasAll(m)
          && validName(d.names[m[0]]) && validName(d.names[m[1]])
          && validAvatar(d.avatars[m[0]]) && validAvatar(d.avatars[m[1]]);
      }

      function validNew() {
        let d = request.resource.data;
        let m = d.members;
        return d.keys().hasOnly(['members', 'code', 'names', 'avatars', 'done', 'streak', 'best', 'streakDay', 'createdAt'])
          && d.keys().hasAll(['members', 'code', 'names', 'avatars', 'done', 'streak', 'best', 'streakDay', 'createdAt'])
          && m is list && m.size() == 2
          && m[0] is string && m[1] is string && m[0] < m[1]
          && pairId == m[0] + '_' + m[1]
          && request.auth.uid in m
          && d.code is string
          && validPeople(d)
          && d.done == {}
          && d.streak == 0 && d.best == 0 && d.streakDay == 0
          && d.createdAt == request.time;
      }

      // The friend's code must exist, belong to the friend and carry the
      // name and avatar written for them.
      function codeMatches() {
        let d = request.resource.data;
        let other = otherOf(d.members);
        let path = /databases/$(database)/documents/friendCodes/$(d.code);
        return exists(path)
          && get(path).data.uid == other
          && d.names[other] == get(path).data.name
          && d.avatars[other] == get(path).data.avatar;
      }

      // Only the caller's own entries in names, avatars and done change;
      // done may only move forward to today.
      function validOwnChange() {
        let me = request.auth.uid;
        let d = request.resource.data;
        let old = resource.data;
        let oldDone = old.done.get(me, 0);
        let newDone = d.done.get(me, 0);
        return d.diff(old).affectedKeys().hasOnly(['done', 'names', 'avatars', 'streak', 'best', 'streakDay'])
          && d.names.diff(old.names).affectedKeys().hasOnly([me])
          && d.avatars.diff(old.avatars).affectedKeys().hasOnly([me])
          && d.done.diff(old.done).affectedKeys().hasOnly([me])
          && validPeople(d)
          && (newDone == oldDone || (newDone == trDay() && newDone > oldDone));
      }

      // The shared streak grows once on the first day both reached the goal;
      // a missed day restarts it at 1. Nothing else may change it.
      function validStreak() {
        let me = request.auth.uid;
        let d = request.resource.data;
        let old = resource.data;
        let t = trDay();
        let bump = d.done.get(me, 0) == t
          && old.done.get(otherOf(old.members), 0) == t
          && old.streakDay != t;
        let next = old.streakDay == t - 1 ? old.streak + 1 : 1;
        return bump
          ? d.streak == next && d.streakDay == t && d.best == (next > old.best ? next : old.best)
          : d.streak == old.streak && d.streakDay == old.streakDay && d.best == old.best;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && hasAccount() && validNew() && codeMatches();
      allow update: if signedIn() && hasAccount()
        && request.auth.uid in resource.data.members
        && validOwnChange() && validStreak();
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // Preset cheers (no free text), at most one per kind per day.
      match /cheers/{cheerId} {
        function parent() {
          return get(/databases/$(database)/documents/friendships/$(pairId)).data;
        }

        function isMember() {
          return signedIn()
            && exists(/databases/$(database)/documents/friendships/$(pairId))
            && request.auth.uid in parent().members;
        }

        function validCheer() {
          let d = request.resource.data;
          return d.keys().hasOnly(['from', 'to', 'kind', 'day', 'createdAt'])
            && d.keys().hasAll(['from', 'to', 'kind', 'day', 'createdAt'])
            && d.from == request.auth.uid
            && d.to == otherOf(parent().members)
            && d.kind in ['tebrik', 'destek', 'hadi', 'harika']
            && d.day == trDay()
            && d.createdAt == request.time
            && cheerId == d.from + '_' + string(d.day) + '_' + d.kind;
        }

        allow read: if isMember();
        allow create: if hasAccount() && isMember() && validCheer();
        allow update: if false;
        allow delete: if isMember();
      }
    }
    // ---- end Friends ----

    // Everything else (quotas, purchase tokens, counters) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
